<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
  <meta name="referrer" content="no-referrer">
  <meta name="report-id" content="{{ report.report_id }}">
  <meta name="report-date" content="{{ report.report_date }}">
  <meta name="generated-at" content="{{ report.generated_at }}">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'">
  <title>US Market Intelligence — {{ report.report_date }}</title>
  <style>
    :root{--bg:#071016;--panel:#0d1922;--panel2:#10222d;--line:#28404d;--text:#e8f0f4;--muted:#91a7b3;--orange:#ff9d2e;--cyan:#42d3ff;--green:#54d89b;--red:#ff6b70;--yellow:#ffd166;color-scheme:dark}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--bg)}
    body{margin:0;background:linear-gradient(180deg,#0b1720 0,#071016 22rem);color:var(--text);font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:var(--cyan);text-decoration:none;overflow-wrap:anywhere}a:hover{text-decoration:underline}
    .shell{width:min(1180px,100%);margin:auto;padding:0 max(16px,env(safe-area-inset-right)) calc(42px + env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left))}
    .masthead{padding:calc(18px + env(safe-area-inset-top)) 0 18px;border-bottom:1px solid var(--line)}
    .terminal-label{color:var(--orange);font:700 12px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.13em;text-transform:uppercase}
    h1{margin:8px 0 4px;font-size:clamp(25px,6vw,43px);line-height:1.05;letter-spacing:-.035em}.subtitle{color:var(--muted);margin:0;font-size:14px}
    .freshness{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin:18px 0 12px;background:var(--line);border:1px solid var(--line);border-radius:10px;overflow:hidden}
    .freshness div{background:var(--panel);padding:12px 14px;min-width:0}.freshness dt{color:var(--muted);font-size:10px;letter-spacing:.1em;text-transform:uppercase}.freshness dd{margin:3px 0 0;color:#fff;font:650 13px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}
    .status-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.badge{display:inline-flex;border:1px solid var(--line);border-radius:999px;padding:3px 8px;color:var(--muted);font:700 10px/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.07em;text-transform:uppercase}.badge.live,.badge.high{border-color:#3c8d6d;color:var(--green)}.badge.medium{border-color:#9a7629;color:var(--yellow)}.badge.low{color:var(--muted)}.badge.risk{border-color:#8b3e43;color:var(--red)}
    nav{display:flex;gap:7px;overflow-x:auto;padding:7px 0 17px;scrollbar-width:none}nav::-webkit-scrollbar{display:none}nav a{flex:0 0 auto;padding:7px 10px;border:1px solid var(--line);border-radius:6px;color:var(--muted);font-size:12px}
    section{scroll-margin-top:12px;margin:28px 0 38px}.section-heading{display:flex;gap:12px;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:9px;margin-bottom:14px}.section-no{color:var(--orange);font:700 12px ui-monospace,SFMono-Regular,Menlo,monospace}.section-heading h2{margin:0;font-size:20px;letter-spacing:-.015em}.section-heading small{color:var(--muted);margin-left:auto}
    .card{background:linear-gradient(145deg,var(--panel),#0a151d);border:1px solid var(--line);border-radius:11px;padding:clamp(15px,3.8vw,24px);margin:13px 0;box-shadow:0 10px 28px rgba(0,0,0,.16)}.card h3{margin:6px 0 7px;font-size:19px;line-height:1.3}.eyebrow{display:flex;justify-content:space-between;gap:8px;align-items:center;color:var(--orange);font:700 11px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase}.summary{font-size:16px;color:#dce8ed}.muted{color:var(--muted)}
    .tags{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}.tag{border:1px solid var(--line);border-radius:4px;background:#0a171f;color:#b8c9d1;padding:2px 7px;font-size:11px}
    .split{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin:13px 0}.case{border-left:3px solid var(--line);padding:2px 0 2px 12px}.case h4{margin:0 0 5px;font-size:12px;text-transform:uppercase;letter-spacing:.05em}.case p{margin:0}.bull{border-color:var(--green)}.bull h4{color:var(--green)}.bear{border-color:var(--red)}.bear h4{color:var(--red)}.base{border-color:var(--yellow)}.base h4{color:var(--yellow)}
    .impact{margin-top:18px;border-top:1px solid var(--line);padding-top:14px}.impact-title{color:var(--cyan);font:700 11px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em;text-transform:uppercase;margin-bottom:10px}.qa{display:grid;grid-template-columns:minmax(145px,.38fr) 1fr;gap:0;border-top:1px solid rgba(40,64,77,.65)}.qa>dt,.qa>dd{margin:0;padding:10px 0;border-bottom:1px solid rgba(40,64,77,.65)}.qa>dt{color:var(--muted);font-size:12px;padding-right:16px}.qa>dd{color:#deeaef}.actor,.indicator{margin:0 0 5px}.actor:last-child,.indicator:last-child{margin:0}.actor strong{color:#fff}.actor span{color:var(--muted)}
    .score-wrap{display:grid;grid-template-columns:92px 1fr;gap:13px;align-items:stretch;margin:14px 0}.score{display:grid;place-items:center;border:1px solid var(--line);border-radius:8px;background:#09151d}.score strong{color:var(--orange);font:750 27px/1 ui-monospace,SFMono-Regular,Menlo,monospace}.score span{display:block;color:var(--muted);font-size:10px;text-align:center;margin-top:4px}.score-table{width:100%;border-collapse:collapse}.score-table td{padding:4px 7px;border-bottom:1px solid rgba(40,64,77,.55);font-size:12px}.score-table td:last-child{text-align:right;color:var(--cyan);font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
    .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:13px 0}.metric{background:#09151d;border:1px solid var(--line);border-radius:7px;padding:10px;min-width:0}.metric dt{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.06em}.metric dd{margin:4px 0 0;font-weight:700;overflow-wrap:anywhere}.metric small{display:block;color:var(--muted);font-weight:400;font-size:10px;margin-top:3px}
    .prediction{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:13px;margin:14px 0}.prediction h4{margin:0 0 8px;color:var(--orange);font-size:12px;text-transform:uppercase}.prediction-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.prediction-grid div{border-left:2px solid var(--line);padding-left:9px}.prediction-grid small{display:block;color:var(--muted);text-transform:uppercase;font-size:9px}.prediction-grid strong{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
    .sources{border-top:1px solid var(--line);margin-top:16px;padding-top:12px}.sources h4{color:var(--muted);margin:0 0 7px;font-size:10px;letter-spacing:.09em;text-transform:uppercase}.source{margin:6px 0;font-size:12px}.source-meta{color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px}.quote{color:var(--muted);font-style:italic}
    .unavailable{border:1px dashed #536873;background:#0a151c;color:#c7d5dc;padding:18px;border-radius:9px}.unavailable strong{display:block;color:var(--yellow);margin-bottom:4px}.knowledge-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.knowledge-grid div{background:#09151d;border:1px solid var(--line);border-radius:7px;padding:12px}.knowledge-grid h4{margin:0 0 6px;color:var(--cyan);font-size:11px;text-transform:uppercase}.knowledge-grid p{margin:0}
    footer{border-top:1px solid var(--line);padding:18px 0 8px;color:var(--muted);font-size:11px}.disclaimer{color:#b8c7ce;margin:0 0 7px}.record-id{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}
    @media(max-width:760px){.freshness{grid-template-columns:1fr 1fr}.metric-grid{grid-template-columns:1fr 1fr}.knowledge-grid{grid-template-columns:1fr}.section-heading small{display:none}}
    @media(max-width:520px){body{font-size:14px}.shell{padding-left:max(12px,env(safe-area-inset-left));padding-right:max(12px,env(safe-area-inset-right))}.freshness{grid-template-columns:1fr}.split{grid-template-columns:1fr}.qa{grid-template-columns:1fr}.qa>dt{border-bottom:0;padding-bottom:2px;color:var(--orange)}.qa>dd{padding-top:3px}.score-wrap{grid-template-columns:1fr}.score{padding:11px}.metric-grid,.prediction-grid{grid-template-columns:1fr 1fr}.card{border-radius:8px}.section-heading{align-items:center}}
    @media print{body{background:#fff;color:#111}.card,.freshness div,.metric,.knowledge-grid div,.prediction{background:#fff;color:#111;box-shadow:none}.shell{width:100%}nav{display:none}a{color:#0645ad}}
  </style>
</head>
<body>
{% macro actors(items) -%}
  {% for actor in items %}<p class="actor"><strong>{{ actor.name }}</strong> <span>— {{ actor.rationale }}</span></p>{% endfor %}
{%- endmacro %}
{% macro impact(analysis) -%}
  <div class="impact">
    <div class="impact-title">Six-question impact analysis / 六項影響分析</div>
    <dl class="qa">
      <dt>1. What changed?<br>發生了什麼變化？</dt><dd>{{ analysis.what_changed }}</dd>
      <dt>2. Why does it matter?<br>為什麼重要？</dt><dd>{{ analysis.why_it_matters }}</dd>
      <dt>3. Who benefits?<br>誰受益？</dt><dd>{{ actors(analysis.beneficiaries) }}</dd>
      <dt>4. Who loses?<br>誰受損？</dt><dd>{{ actors(analysis.losers) }}</dd>
      <dt>5. How would professional investors react?<br>專業投資人可能如何反應？</dt><dd>{{ analysis.professional_investor_reaction }}</dd>
      <dt>6. What indicators should be monitored next?<br>接下來應監測哪些指標？</dt><dd>{% for item in analysis.indicators_to_monitor_next %}<p class="indicator">• {{ item }}</p>{% endfor %}</dd>
    </dl>
  </div>
{%- endmacro %}
{% macro sources(items) -%}
  <div class="sources"><h4>Sources &amp; as-of lineage</h4>
  {% for source in items %}<div class="source"><a href="{{ source.url }}" rel="noopener noreferrer nofollow">{{ source.title }}</a><div class="source-meta">{{ source.publisher }} · Tier {{ source.tier }} · accessed {{ source.accessed_at }}{% if source.published_at %} · published {{ source.published_at }}{% endif %}</div>{% if source.quoted_fragment %}<div class="quote">“{{ source.quoted_fragment }}”</div>{% endif %}</div>{% endfor %}
  </div>
{%- endmacro %}
{% macro score(total, components) -%}
  <div class="score-wrap"><div class="score"><div><strong>{{ total }}</strong><span>out of 10</span></div></div><table class="score-table"><tbody>{% for component in components %}<tr><td>{{ component.key|replace('_',' ')|title }}</td><td>{{ component.value }}</td></tr>{% endfor %}</tbody></table></div>
{%- endmacro %}
{% macro metric(label, item) -%}
  <div class="metric"><dt>{{ label }}</dt><dd>{% if item.status == 'known' %}{{ item.value }} {{ item.unit }}<small>{{ item.provider }} · as of {{ item.as_of }}</small>{% else %}Unavailable<small>{{ item.unavailable_reason }}</small>{% endif %}</dd></div>
{%- endmacro %}
<div class="shell">
  <header class="masthead">
    <div class="terminal-label">Daily intelligence / Personal research</div>
    <h1>US Market Intelligence</h1>
    <p class="subtitle">專業市場晨報 · Independent evidence-linked analysis</p>
    <dl class="freshness">
      <div><dt>Report date</dt><dd>{{ report.report_date }}</dd></div>
      <div><dt>Market status</dt><dd>{{ report.market_context.market_status }}</dd></div>
      <div><dt>Generated time</dt><dd>{{ report.generated_at }}</dd></div>
      <div><dt>Source cutoff</dt><dd>{{ report.source_cutoff_at }}</dd></div>
    </dl>
    <div class="status-row"><span class="badge live">{{ report.validation_status }}</span><span class="badge">{{ report.timezone }}</span><span class="badge">Tomorrow {{ report.market_context.tomorrow_date }}: {{ report.market_context.tomorrow_status }}</span><span class="badge">Previous session {{ report.market_context.previous_session }}</span></div>
  </header>
  <nav aria-label="Report sections"><a href="#news">Market News</a><a href="#earnings">Earnings</a><a href="#macro">Global Macro</a><a href="#research">New Research</a><a href="#knowledge">Knowledge</a></nav>

  <main>
    <section id="news"><div class="section-heading"><span class="section-no">01</span><h2>Market News / 市場要聞</h2><small>Top {{ report.market_news|length }} by deterministic attention score</small></div>
    {% if report.section_statuses.market_news.detail %}<div class="unavailable"><strong>{% if report.section_statuses.market_news.status == 'degraded' %}Official-feed coverage degraded{% else %}Source-window disclosure{% endif %}</strong>{{ report.section_statuses.market_news.detail }}</div>{% endif %}
    {% for item in report.market_news %}<article class="card"><div class="eyebrow"><span>News #{{ loop.index }} · {{ item.event_date }}</span><span class="badge {{ item.market_impact|lower }}">{{ item.market_impact }} impact</span></div><h3>{{ item.title }}</h3><div class="tags">{% for sector in item.affected_sectors %}<span class="tag">{{ sector }}</span>{% endfor %}</div><p class="summary">{{ item.summary }}</p><div class="split"><div class="case bull"><h4>Bullish case</h4><p>{{ item.bull_case }}</p></div><div class="case bear"><h4>Bearish case</h4><p>{{ item.bear_case }}</p></div></div>{{ score(item.attention_score,item.score_components) }}{{ impact(item.impact) }}{{ sources(item.sources) }}</article>{% endfor %}
    </section>

    <section id="earnings"><div class="section-heading"><span class="section-no">02</span><h2>Earnings Watchlist / 財報關注</h2><small>Target {{ report.earnings.target_date }}</small></div>
    {% if report.earnings.universe_coverage == 'bounded_research' and report.earnings.status != 'market_closed' %}<div class="unavailable"><strong>Coverage limitation</strong>This is a bounded, cited-research candidate universe—not an authoritative full earnings calendar. Full-universe coverage requires a licensed calendar adapter.</div>{% endif %}
    {% if report.earnings.status == 'market_closed' %}<div class="unavailable"><strong>Market closed</strong>{{ report.earnings.message }}{% if report.earnings.next_open_session %}<br>Next open session: {{ report.earnings.next_open_session }}{% endif %}</div>
    {% elif report.earnings.status == 'no_qualifying_candidates' %}<div class="unavailable"><strong>No qualifying candidates</strong>{{ report.earnings.message }}</div>
    {% elif report.earnings.status == 'data_unavailable' %}<div class="unavailable"><strong>Calendar data unavailable / 財報日曆資料不可用</strong>{{ report.earnings.message }}<br>This does not mean that no companies report on the target date.</div>
    {% elif report.earnings.status == 'unavailable' %}<div class="unavailable"><strong>Earnings analysis unavailable</strong>{{ report.earnings.message }}</div>
    {% else %}{% for item in report.earnings.candidates %}<article class="card"><div class="eyebrow"><span>{{ item.ticker }} · {{ item.company_name }} · {{ item.sector }}</span><span class="badge risk">Risk level: {{ item.risk_level }}</span></div><h3>Earnings release · {{ item.release_timing_label }}</h3><div class="status-row"><span class="badge">Market attention: {{ item.market_attention }}</span></div><p class="summary"><strong>Why important:</strong> {{ item.why_important }}</p><div class="metric-grid">{{ metric('Current price',item.current_price) }}{{ metric('Market cap',item.market_cap) }}{{ metric('Expected EPS',item.expected_eps) }}{{ metric('Expected revenue',item.expected_revenue) }}</div>{{ score(item.selection_score,item.selection_components) }}<div class="split"><div class="case bull"><h4>Bull scenario</h4><p>{{ item.bull_case }}</p></div><div class="case base"><h4>Base scenario</h4><p>{{ item.base_case }}</p></div></div><div class="case bear"><h4>Bear scenario</h4><p>{{ item.bear_case }}</p></div><div class="case"><h4>Risk analysis</h4><p>{{ item.risk }}</p></div><div class="prediction"><h4>Ex-ante prediction</h4><div class="prediction-grid"><div><small>Direction</small><strong>{{ item.prediction.direction }}</strong></div><div><small>Confidence</small><strong>{{ item.prediction.confidence }}</strong></div><div><small>Horizon</small><strong>{{ item.prediction.horizon }}</strong></div><div><small>Evaluation window</small><strong>{{ item.prediction.event_window.starts_at }} → {{ item.prediction.event_window.ends_at }}{% if item.prediction.event_window.anchor_basis == 'market_window_proxy' %} (market-window proxy; exact release time unconfirmed){% endif %}</strong></div><div><small>Benchmark</small><strong>{{ item.prediction.event_window.benchmark }}</strong></div><div><small>Prediction ID</small><strong>{{ item.prediction.prediction_id }}</strong></div></div><h4>Falsification conditions</h4>{% for condition in item.prediction.falsification_conditions %}<p class="indicator">• {{ condition }}</p>{% endfor %}</div>{{ impact(item.impact) }}{{ sources(item.sources) }}</article>{% endfor %}{% endif %}
    </section>

    <section id="macro"><div class="section-heading"><span class="section-no">03</span><h2>Global Macro / 全球宏觀</h2></div>
    {% if report.section_statuses.global_macro.detail %}<div class="unavailable"><strong>{% if report.section_statuses.global_macro.status == 'degraded' %}Official-feed coverage degraded{% else %}Source-window disclosure{% endif %}</strong>{{ report.section_statuses.global_macro.detail }}</div>{% endif %}
    {% if report.global_macro %}<article class="card"><div class="eyebrow"><span>{{ report.global_macro.event_date }}</span><span class="badge {{ report.global_macro.market_impact|lower }}">{{ report.global_macro.market_impact }} impact</span></div><h3>{{ report.global_macro.title }}</h3><div class="tags">{% for asset in report.global_macro.affected_assets %}<span class="tag">{{ asset }}</span>{% endfor %}</div><p class="summary">{{ report.global_macro.summary }}</p>{{ impact(report.global_macro.impact) }}{{ sources(report.global_macro.sources) }}</article>{% else %}<div class="unavailable"><strong>Global macro unavailable</strong>{{ report.section_statuses.global_macro.detail }}</div>{% endif %}
    </section>

    <section id="research"><div class="section-heading"><span class="section-no">04</span><h2>New Research / 新知探索</h2></div>
    {% if report.research_discovery %}<article class="card"><div class="eyebrow"><span>Discovered {{ report.research_discovery.discovered_on }}</span><span>Research</span></div><h3>{{ report.research_discovery.title }}</h3><h4>Simple explanation</h4><p class="summary">{{ report.research_discovery.plain_explanation }}</p><h4>Changed belief</h4><p>{{ report.research_discovery.changed_belief }}</p><h4>Investment / business applications</h4>{% for application in report.research_discovery.applications %}<p class="indicator"><strong>{{ application.category|replace('_', ' ')|title }}:</strong> {{ application.application }}</p>{% endfor %}{% if report.research_discovery.impact %}{{ impact(report.research_discovery.impact) }}{% endif %}{{ sources(report.research_discovery.sources) }}</article>{% else %}<div class="unavailable"><strong>Research discovery unavailable</strong>{{ report.section_statuses.research_discovery.detail }}</div>{% endif %}
    </section>

    <section id="knowledge"><div class="section-heading"><span class="section-no">05</span><h2>Knowledge Refresh / 經典知識</h2></div>
    {% if report.knowledge_refresh %}<article class="card"><div class="eyebrow"><span>Classic concept</span><span>Refresh</span></div><h3>{{ report.knowledge_refresh.concept }}</h3><div class="knowledge-grid"><div><h4>Historical background</h4><p>{{ report.knowledge_refresh.background }}</p></div><div><h4>Simple explanation</h4><p>{{ report.knowledge_refresh.explanation }}</p></div><div><h4>Why it still matters</h4><p>{{ report.knowledge_refresh.current_relevance }}</p></div><div><h4>Real-world example</h4><p>{{ report.knowledge_refresh.example }}</p></div></div></article>{% else %}<div class="unavailable"><strong>Knowledge refresh unavailable</strong>{{ report.section_statuses.knowledge_refresh.detail }}</div>{% endif %}
    </section>
  </main>
  <footer><p class="disclaimer">For personal research and education only. This report is not investment advice, an offer, or a recommendation. Market data may be delayed or unavailable; verify facts with primary sources before acting.</p><div>Report ID: <span class="record-id">{{ report.report_id }}</span> · Schema {{ report.schema_version }} · Next open session {{ report.market_context.next_open_session }}</div></footer>
</div>
</body>
</html>
